{
  "name": "kepuca-e-arte",
  "version": "1.0.0",
  "private": true,
  "description": "Kepuca e Arte — React client + Express API, served as one Node app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:client": "npm install --prefix client --include=dev",
    "install:server": "npm install --prefix server --omit=dev",
    "postinstall": "npm run install:server && npm run install:client",
    "build": "npm run build --prefix client",
    "start": "node server/src/index.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client"
  }
}
